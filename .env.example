# ─── Panel de administración (/admin) ───

# Clave larga y aleatoria para firmar la sesión (mínimo 32 caracteres).
# Se puede generar con: openssl rand -base64 48
NFD_SESSION_SECRET=

# Cuenta de administración (acceso completo, puede eliminar eventos).
NFD_ADMIN_USER=admin
NFD_ADMIN_PASSWORD=

# Cuenta de usuario (carga, modifica, publica y archiva; no elimina).
NFD_EDITOR_USER=emiliano
NFD_EDITOR_PASSWORD=

# ─── Almacenamiento ───

# En Vercel: crear un Blob store (público) en Storage y conectarlo al
# proyecto; Vercel agrega solo BLOB_STORE_ID (o BLOB_READ_WRITE_TOKEN en
# proyectos más viejos). Sin ninguna de las dos, el contenido se guarda
# en la carpeta local .content/ (solo para desarrollo o servidor propio).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
